{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "es2020"
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
