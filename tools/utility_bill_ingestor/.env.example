# ── Supabase ──────────────────────────────────────────────────────────────
# Same project as the Next.js app (see ../../.env.local for the URL).
# SUPABASE_SERVICE_ROLE_KEY is a secret — get it from Supabase Dashboard →
# Settings → API → service_role. NEVER commit it, NEVER put it in the Next.js
# app's .env.local, NEVER expose it to a browser.
SUPABASE_URL=https://gufzgemtfgrfcotlzmuq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Folders ───────────────────────────────────────────────────────────────
# Default: a new "_inbox" subfolder inside the same OneDrive folder where all
# utility bills already live, so "processed" bills land back in the existing
# {COMPANY}\{VENDOR}\... structure you already use. Override if you'd rather
# keep everything local instead.
UTILITY_BILL_INBOX=C:\Users\nero_\OneDrive - afstrans.co\afstrans.co - AFS_2023\Admin\0. Admin Dashboard\0. DB\_inbox
UTILITY_BILL_ARCHIVE_ROOT=C:\Users\nero_\OneDrive - afstrans.co\afstrans.co - AFS_2023\Admin\0. Admin Dashboard\0. DB
# Local working data (processing/review/failed/logs) — deliberately NOT in
# OneDrive, so partial/atomic file moves never race with cloud sync.
UTILITY_BILL_DATA_DIR=./data
# Optional override just for review/ — unlike processing/, a file only ever
# lands here via a completed move, so there's no sync-race risk, and putting
# it in OneDrive (e.g. a "_review" folder next to _inbox) makes files needing
# a human look reachable from any device. Defaults to {DATA_DIR}/review.
UTILITY_BILL_REVIEW_DIR=

# ── Behavior ──────────────────────────────────────────────────────────────
ENABLE_OCR=false
DRY_RUN=false
# Seconds a file's size+mtime must stay unchanged before it's considered
# "done copying" (OneDrive sync / browser download safety).
STABILITY_WINDOW_SECONDS=5
# Allowed absolute mismatch (CAD/USD) for previous_balance + current_charges
# + tax - payments_received ≈ total_due before it's flagged as a warning.
AMOUNT_TOLERANCE=0.05

# ── Microsoft Graph (OneDrive file links) ───────────────────────────────
# Optional. Once all 4 values below are set, every bill the ingestor
# registers also gets an "organization"-scoped OneDrive sharing link saved
# to utility_bills.onedrive_file_url, which the web app already renders as
# a 📎 "Open file" link — no site code changes needed. Leave any of these
# blank and this feature is simply skipped (never blocks a bill from being
# registered). See README.md "OneDrive file links" for the full setup
# (Azure AD app registration + how to find GRAPH_DRIVE_ID).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# The id of the specific SharePoint/OneDrive drive that holds the bills —
# find it with `python -m scripts.graph_discover_drive` after the 3 values
# above are filled in.
GRAPH_DRIVE_ID=
# A local folder path (usually somewhere under UTILITY_BILL_ARCHIVE_ROOT's
# ancestry) that maps to a known path inside the drive above.
GRAPH_DRIVE_ROOT_LOCAL=
# The drive-relative path (from the drive's actual root, forward slashes,
# no leading/trailing slash) that GRAPH_DRIVE_ROOT_LOCAL corresponds to.
# Leave blank only if GRAPH_DRIVE_ROOT_LOCAL genuinely *is* the drive root
# — in practice a local OneDrive "shortcut" folder is often renamed on sync
# (e.g. local "afstrans.co - AFS_2023" for a folder actually named
# "AFS_2023" on the drive), so this is usually non-empty. Verify with a
# real file before trusting it — see README.md "OneDrive file links".
GRAPH_DRIVE_ROOT_REMOTE_PREFIX=
